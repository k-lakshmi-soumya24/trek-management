# Copy this file to .env, then replace the placeholder with your OpenAI API key.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=replace_with_your_real_openai_api_key

# Optional. The default is gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# Generate both secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_private_random_value_at_least_32_characters
ADMIN_SETUP_CODE=replace_with_a_different_private_random_value_at_least_24_characters
